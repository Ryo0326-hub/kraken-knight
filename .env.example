# Production: install as /etc/kraken-knight/config.env, owned by
# root:kraken-knight with mode 0640. Never commit a populated environment file.

# Safe runtime default. Recognized: backtest, paper, shadow, validate; live is
# deliberately rejected by the Checkpoint 2 build.
KRAKEN_KNIGHT_MODE=shadow
KRAKEN_KNIGHT_STATE_DIR=/var/lib/kraken-knight
KRAKEN_KNIGHT_ACCOUNT_ID=dedicated-btc-cad
KRAKEN_KNIGHT_PAIR=BTC/CAD
KRAKEN_KNIGHT_STRATEGY_ID=btc_cad_daily_momentum_v3_no_drawdown

# Credentials remain blank in source control. Create a fresh Kraken Knight key;
# never reuse the legacy bot key. Restrict it to the production host IP and grant
# exactly: Query Funds, Query Open Orders & Trades, Query Closed Orders & Trades,
# and Query Ledger Entries. Leave every other permission disabled.
KRAKEN_KNIGHT_KRAKEN_API_KEY=
KRAKEN_KNIGHT_KRAKEN_API_SECRET=
# These fields bind the read workflow without echoing their values in status
# output. Use the new key's exact Kraken name and this host's allowlisted address.
KRAKEN_KNIGHT_EXPECTED_KRAKEN_KEY_NAME=
KRAKEN_KNIGHT_EXPECTED_KRAKEN_IP=
# Bootstrap this value with `kraken-knight account-id --json`, review the returned
# public wallet ID, then pin that exact ID here before reconciliation.
KRAKEN_KNIGHT_EXPECTED_KRAKEN_ACCOUNT_ID=
# Restricted JSON evidence used to match the five uncertain legacy submissions.
# Keep it outside the release tree; the CLI flag may override this path manually.
KRAKEN_KNIGHT_LEGACY_HINTS_PATH=/var/lib/kraken-knight/legacy-hints.json
# Bootstrap this digest with `kraken-knight legacy-manifest --json` after reviewing
# all five hints and their five unique Kraken order IDs, then pin it here.
KRAKEN_KNIGHT_EXPECTED_LEGACY_MANIFEST_HASH=
# Leave this blank for the first supervised reconciliation. That run is expected
# to be UNRESOLVED: review the account-lifetime and fenced-tail ledger entries and
# evidence.funding_manifest_hash, then pin the hash only if every non-trade entry
# is a recognized positive inbound CAD deposit. Rerun reconciliation afterwards.
KRAKEN_KNIGHT_EXPECTED_FUNDING_MANIFEST_HASH=
# Leave false until the legacy writer and every restart path are stopped/disabled
# and manual Kraken trading is stopped for the supervised cutover. Set true only
# while that assertion is accurate; set it false again if quiescence ends.
KRAKEN_KNIGHT_CUTOVER_QUIESCED=false

# Checkpoint 2 uses the credentials only for allowlisted authenticated reads and
# reconciliation. It has no exchange-write adapter or durable release-bound arm.
# These placeholders document the future surface; they cannot enable trading.
KRAKEN_KNIGHT_LIVE_TRADING_ENABLED=false
KRAKEN_KNIGHT_LIVE_TRADING_CONFIRMATION=
# Exact deliberate acknowledgement when a reviewed live release is authorized:
# KRAKEN_KNIGHT_LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_ORDERS
