# Install as /etc/kraken-knight/daily.env, owned by root:kraken-knight and mode
# 0640. This environment is deliberately credential-free.

KRAKEN_KNIGHT_STATE_DIR=/var/lib/kraken-knight
KRAKEN_KNIGHT_ACCOUNT_ID=dedicated-btc-cad
KRAKEN_KNIGHT_PAIR=BTC/CAD
KRAKEN_KNIGHT_STRATEGY_ID=btc_cad_daily_momentum_v3_no_drawdown

# Replace with the full lowercase Git SHA used as the immutable release
# directory: /opt/kraken-knight/releases/<sha>. The command verifies both.
KRAKEN_KNIGHT_RELEASE_ID=replace-with-reviewed-full-lowercase-git-sha

# Do not add any KRAKEN_API_KEY, KRAKEN_API_SECRET, account-binding, legacy,
# Blockchair, or live-arming fields. The systemd unit independently pins shadow.
