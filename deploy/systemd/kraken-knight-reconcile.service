[Unit]
Description=Kraken Knight authenticated read-only reconciliation
Documentation=https://github.com/Ryo0326-hub/kraken-knight/blob/main/docs/RUNBOOK.md
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/opt/kraken-knight/current

[Service]
Type=oneshot
User=kraken-knight
Group=kraken-knight
WorkingDirectory=/opt/kraken-knight/current
EnvironmentFile=/etc/kraken-knight/config.env
Environment=PYTHONUNBUFFERED=1
UMask=0077

# Checkpoint 2 may read Kraken and append a sanitized local snapshot. The CLI
# has no exchange-write command. Keep this unit disabled until the dedicated
# read-only key and all pinned bindings are reviewed, the legacy/manual account
# freeze is verified, a supervised rerun is CLEAN, and later installation is
# explicitly authorized under the runbook.
ExecStart=/opt/kraken-knight/current/.venv/bin/kraken-knight init --json
ExecStart=/opt/kraken-knight/current/.venv/bin/kraken-knight reconcile

StateDirectory=kraken-knight
StateDirectoryMode=0700
RuntimeDirectory=kraken-knight
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths=/etc/kraken-knight/config.env
ReadWritePaths=/var/lib/kraken-knight
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=64
MemoryMax=512M
TimeoutStartSec=10min
